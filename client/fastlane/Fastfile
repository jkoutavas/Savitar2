require "shellwords"

default_platform(:mac)

# Anchor all shell commands to the client/ directory (the parent of fastlane/),
# so relative paths resolve regardless of fastlane's working directory.
PROJECT_ROOT = File.expand_path("..", __dir__)
PROJECT = "Savitar2.xcodeproj"
SCHEME = "Savitar2"
BUILD_DIR = "build/fastlane"
RELEASE_DIR = "fastlane/release"
ARCHIVE_PATH = "#{BUILD_DIR}/Savitar2.xcarchive"
APP_PATH = "#{ARCHIVE_PATH}/Products/Applications/Savitar.app"
ZIP_PATH = "#{RELEASE_DIR}/Savitar.zip"

# CHANGELOG.md lives at the repository root (the parent of client/).
REPO_ROOT = File.expand_path("../..", __dir__)
CHANGELOG_PATH = File.join(REPO_ROOT, "CHANGELOG.md")
CHANGELOG_REPO_URL = "https://github.com/jkoutavas/Savitar2"
APPCAST_DIR = File.join(PROJECT_ROOT, "appcast")
APPCAST_UPDATES_DIR = File.join(APPCAST_DIR, "updates")
APPCAST_XML = File.join(APPCAST_DIR, "appcast.xml")
SPARKLE_DERIVED_DATA = File.join(PROJECT_ROOT, "build/sparkle-tools")

def sparkle_tool(name)
  path = File.join(SPARKLE_DERIVED_DATA, "SourcePackages/artifacts/sparkle/Sparkle/bin/#{name}")
  unless File.exist?(path)
    UI.message("Resolving Swift packages for Sparkle tools…")
    Dir.chdir(PROJECT_ROOT) do
      sh(
        "xcodebuild -resolvePackageDependencies " \
        "-project #{PROJECT.shellescape} " \
        "-scheme #{SCHEME.shellescape} " \
        "-derivedDataPath #{SPARKLE_DERIVED_DATA.shellescape}"
      )
    end
  end
  UI.user_error!("Sparkle tool not found: #{name}") unless File.exist?(path)
  path
end

def changelog_section(version)
  section = +""
  capture = false
  File.foreach(CHANGELOG_PATH) do |line|
    if line =~ /^## \[#{Regexp.escape(version)}\]/
      capture = true
      next
    end
    break if capture && line =~ /^## \[/ 

    section << line if capture
  end
  section.strip
end

def require_env!(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable: #{name}") if value.to_s.empty?
  value
end

# Monotonic build number derived from the git history depth. Read-only, so it
# never dirties the working tree. Requires full history (CI must checkout with
# fetch-depth: 0; a shallow clone would report 1).
def git_build_number
  count = `git -C #{PROJECT_ROOT.shellescape} rev-list --count HEAD`.strip
  if count.empty? || count == "0"
    UI.user_error!("Could not determine a build number from git history. Ensure this is a full clone (fetch-depth: 0).")
  end
  count
end

# Marketing version (CFBundleShortVersionString) for a release. The release tag
# is the single source of truth: pushing tag `v2.0.16` yields marketing version
# `2.0.16` with no committed file edits. Prefers the RELEASE_VERSION env (set by
# CI from the tag), then the tag pointing at HEAD, and otherwise returns nil so
# the project's MARKETING_VERSION (a local/dev fallback) is used as-is.
def release_marketing_version
  version = ENV["RELEASE_VERSION"].to_s.strip
  if version.empty?
    version = `git -C #{PROJECT_ROOT.shellescape} describe --exact-match --tags HEAD 2>/dev/null`.strip
  end
  version = version.sub(/\Av/, "")
  version.empty? ? nil : version
end

platform :mac do
  # Keep our hand-written fastlane/README.md; don't let fastlane overwrite it
  # with its auto-generated lane index on every run.
  before_all do
    skip_docs
  end

  desc "Build the app locally without signing, matching the pull request test build."
  lane :test_build do
    Dir.chdir(PROJECT_ROOT) do
      sh(
        "xcodebuild build-for-testing " \
        "-project #{PROJECT.shellescape} " \
        "-scheme #{SCHEME.shellescape} " \
        "-destination 'platform=macOS' " \
        "-derivedDataPath #{BUILD_DIR.shellescape} " \
        "CODE_SIGNING_ALLOWED=NO " \
        "CODE_SIGNING_REQUIRED=NO " \
        "CODE_SIGN_IDENTITY='' " \
        "ONLY_ACTIVE_ARCH=YES"
      )
    end
  end

  desc "Create a Developer ID signed release archive and zip it for notarization."
  lane :release_archive do
    team_id = require_env!("APPLE_TEAM_ID")
    signing_identity = require_env!("DEVELOPER_ID_APPLICATION")
    build_number = git_build_number
    marketing_version = release_marketing_version

    version_overrides = +"CURRENT_PROJECT_VERSION=#{build_number.shellescape} "
    version_overrides << "MARKETING_VERSION=#{marketing_version.shellescape} " if marketing_version

    Dir.chdir(PROJECT_ROOT) do
      sh("rm -rf #{ARCHIVE_PATH.shellescape} #{ZIP_PATH.shellescape}")
      sh("mkdir -p #{RELEASE_DIR.shellescape}")

      sh(
        "xcodebuild archive " \
        "-project #{PROJECT.shellescape} " \
        "-scheme #{SCHEME.shellescape} " \
        "-configuration Release " \
        "-archivePath #{ARCHIVE_PATH.shellescape} " \
        "-destination 'generic/platform=macOS' " \
        "#{version_overrides}" \
        "CODE_SIGN_STYLE=Manual " \
        "DEVELOPMENT_TEAM=#{team_id.shellescape} " \
        "CODE_SIGN_IDENTITY=#{signing_identity.shellescape}"
      )

      sh("ditto -c -k --keepParent #{APP_PATH.shellescape} #{ZIP_PATH.shellescape}")
    end
    UI.success("Created #{ZIP_PATH} — version #{marketing_version || "(project default)"} (build #{build_number})")
  end

  desc "Submit the release zip to Apple notarization and staple the accepted ticket."
  lane :notarize do
    key_id = require_env!("APP_STORE_CONNECT_KEY_ID")
    issuer_id = require_env!("APP_STORE_CONNECT_ISSUER_ID")
    key_path = require_env!("APP_STORE_CONNECT_KEY_PATH")

    Dir.chdir(PROJECT_ROOT) do
      UI.user_error!("Missing release zip. Run `bundle exec fastlane release_archive` first.") unless File.exist?(ZIP_PATH)

      sh(
        "xcrun notarytool submit #{ZIP_PATH.shellescape} " \
        "--key #{key_path.shellescape} " \
        "--key-id #{key_id.shellescape} " \
        "--issuer #{issuer_id.shellescape} " \
        "--wait"
      )

      sh("xcrun stapler staple #{APP_PATH.shellescape}")
      sh("ditto -c -k --keepParent #{APP_PATH.shellescape} #{ZIP_PATH.shellescape}")
    end
    UI.success("Notarized, stapled, and repackaged #{ZIP_PATH}")
  end

  desc "Build, notarize, staple, and package a local release zip."
  lane :release do
    release_archive
    notarize
  end

  desc "Stamp the changelog's [Unreleased] section as a dated release. " \
       "Usage: bundle exec fastlane prepare_release version:2.0.16"
  lane :prepare_release do |options|
    version = options[:version].to_s.strip.sub(/\Av/, "")
    UI.user_error!("Provide a version, e.g. `bundle exec fastlane prepare_release version:2.0.16`") if version.empty?

    text = File.read(CHANGELOG_PATH)
    UI.user_error!("No '## [Unreleased]' heading found in CHANGELOG.md.") unless text.include?("## [Unreleased]")
    if text =~ /^## \[#{Regexp.escape(version)}\]/
      UI.user_error!("CHANGELOG.md already has a section for #{version}.")
    end

    date = Time.now.strftime("%Y-%m-%d")

    # Insert a dated version heading directly below [Unreleased]; the accumulated
    # notes move under the new version, leaving [Unreleased] empty for next time.
    text = text.sub(/^## \[Unreleased\][^\n]*\n/, "## [Unreleased]\n\n## [#{version}] - #{date}\n")

    # Point the compare link at the new tag and add a release link for the version.
    unreleased_link = "[Unreleased]: #{CHANGELOG_REPO_URL}/compare/v#{version}...HEAD"
    version_link = "[#{version}]: #{CHANGELOG_REPO_URL}/releases/tag/v#{version}"
    if text =~ /^\[Unreleased\]:.*$/
      text = text.sub(/^\[Unreleased\]:.*$/, "#{unreleased_link}\n#{version_link}")
    else
      text = "#{text.rstrip}\n\n#{unreleased_link}\n#{version_link}\n"
    end

    File.write(CHANGELOG_PATH, text)
    UI.success("Stamped CHANGELOG.md: [Unreleased] → #{version} (#{date}).")
    UI.message("Next: commit CHANGELOG.md via a PR, then tag v#{version} to release.")
  end

  desc "Update client/appcast/appcast.xml from the release zip and CHANGELOG. " \
       "Usage: bundle exec fastlane sparkle_appcast version:2.0.16"
  lane :sparkle_appcast do |options|
    version = options[:version].to_s.strip.sub(/\Av/, "")
    version = release_marketing_version if version.empty?
    UI.user_error!("Provide version:, e.g. sparkle_appcast version:2.0.16") if version.to_s.empty?

    require_env!("SPARKLE_EDDSA_PRIVATE_KEY")
    tag = "v#{version}"
    generate_appcast = sparkle_tool("generate_appcast")

    Dir.chdir(PROJECT_ROOT) do
      UI.user_error!("Missing release zip at #{ZIP_PATH}") unless File.exist?(ZIP_PATH)

      sh("mkdir -p #{APPCAST_UPDATES_DIR.shellescape}")
      sh("cp #{ZIP_PATH.shellescape} #{File.join(APPCAST_UPDATES_DIR, 'Savitar.zip').shellescape}")

      notes = changelog_section(version)
      unless notes.empty?
        File.write(File.join(APPCAST_UPDATES_DIR, "Savitar.md"), notes)
      end

      prefix = "#{CHANGELOG_REPO_URL}/releases/download/#{tag}/"
      sh("#{generate_appcast.shellescape} --download-url-prefix #{prefix.shellescape} #{APPCAST_UPDATES_DIR.shellescape}")
      sh("mv #{File.join(APPCAST_UPDATES_DIR, 'appcast.xml').shellescape} #{APPCAST_XML.shellescape}")
    end
    UI.success("Updated #{APPCAST_XML} for #{tag}. Commit and push to master.")
  end
end
